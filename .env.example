# Copy to .env and replace every value. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
JWT_SECRET=replace-with-64-hex-chars
LIVEKIT_API_SECRET=replace-with-64-hex-chars

# Phase 3 (optional; these are the defaults). Local = free and private, runs on your machine.
# TRANSCRIPTION_PROVIDER=local     # or groq
# WHISPER_MODEL=small              # tiny | base | small | medium
# WHISPER_LANGUAGE=                # e.g. en; empty = auto-detect
# LLM_PROVIDER=ollama              # or groq
# OLLAMA_MODEL=llama3.1:8b         # llama3.2:3b on a Mac with 8 GB of RAM
# GROQ_API_KEY=                    # free key from console.groq.com (demo data only: audio leaves your machine)
